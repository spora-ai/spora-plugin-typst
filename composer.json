{
    "name": "spora-ai/spora-plugin-typst",
    "description": "Typst document compilation for Spora agents — backed by ext-typst and the media-derivatives abstraction.",
    "type": "spora-plugin",
    "license": "MIT",
    "keywords": ["spora", "plugin", "typst", "typesetting", "pdf", "media-derivatives"],
    "require": {
        "php": "^8.4.1",
        "ext-typst": "*",
        "spora-ai/spora-core": "dev-feat/media-principal-coverage as 0.19.x-dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Spora\\Plugins\\Typst\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spora\\Plugins\\Typst\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "lint": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "format": "php-cs-fixer fix --no-interaction"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "spora-ai/installer": true
        },
        "preferred-install": {
            "spora-ai/spora-core": "source"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/spora-ai/spora-core.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
